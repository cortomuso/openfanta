{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/nix/store/w4jwbp69h5kyb9b4fa1kj5338iw6pjqv-graphify-0.9.91/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/nix/store/w4jwbp69h5kyb9b4fa1kj5338iw6pjqv-graphify-0.9.91/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}